# Normalize line endings. Text files are LF in the repo; checked out natively.
* text=auto eol=lf

# Visual Studio / MSBuild files are CRLF to avoid churn when VS rewrites them.
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Language-aware diffs.
*.cs text diff=csharp

# Binary assets — never normalized.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.nupkg binary
*.snupkg binary
